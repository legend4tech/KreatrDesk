# ==============================================================================
# KreatrDesk — Production & Local Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to .env.local for local development.
# 2. For deployment, configure these variables in your hosting dashboard (e.g. Vercel).
#
# IMPORTANT:
# - NEXT_PUBLIC_* variables are exposed to the browser.
# - All other variables are STRICTLY SERVER-ONLY.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Domain Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
APPLICATION_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Database: MongoDB Atlas (Server-Only)
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/
MONGODB_DB=kreatrdesk

# ------------------------------------------------------------------------------
# 3. Web3 & Base Sepolia Blockchain Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_CHAIN_ID=84532
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Deployed Base Sepolia Contract Addresses
NEXT_PUBLIC_MOCK_USDC_ADDRESS=0xE9557485Ccd568c3984451f04f4ceF6E5b63809a
NEXT_PUBLIC_UMUNNA_POT_ADDRESS=0xdd3f4312a0f8a22ca0a5e31fb7dad7afc8916aaa
NEXT_PUBLIC_KREATR_ESCROW_ADDRESS=0xdd3f4312a0f8a22ca0a5e31fb7dad7afc8916aaa

# Server-side Relayer Private Key for gasless transactions (Optional / Testnet)
RELAYER_PRIVATE_KEY=

# ------------------------------------------------------------------------------
# 4. Roqqu API Services (RAS) — Dual-Rail Fiat/Naira Gateway (Server-Only)
# ------------------------------------------------------------------------------
ROQQU_BASE_URL=https://service.roqqu.com/v1
ROQQU_MODE=staging
ROQQU_SECRET_KEY=RASPRIV_YOUR_SECRET_KEY_HERE
ROQQU_PUBLIC_KEY=RASPUB_YOUR_PUBLIC_KEY_HERE

# ------------------------------------------------------------------------------
# 5. AI Integration: OpenRouter / Gemini Multimodal (Server-Only)
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5
OPENROUTER_FALLBACK_MODEL=google/gemini-2.5-flash
OPENROUTER_TIMEOUT_SECONDS=15

# ------------------------------------------------------------------------------
# 6. Cloudinary Media Storage (UGC Video Deliverables & Portfolios) (Server-Only)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
